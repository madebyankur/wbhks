{
  "name": "wbhks",
  "version": "1.0.0",
  "description": "A developer-friendly webhook integration kit for Next.js Edge Runtime with signature verification, event routing, retries, and testing",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./frameworks": {
      "types": "./dist/frameworks.d.ts",
      "import": "./dist/frameworks.mjs",
      "require": "./dist/frameworks.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:tsc",
    "build:tsc": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:tsup": "tsup",
    "build:watch": "tsc --watch",
    "build:analyze": "tsup --analyze",
    "test": "bun test",
    "playground": "bun run playground/test-playground.ts",
    "prepare": "npm run build",
    "dev:playground": "bun run playground/test-playground.ts"
  },
  "keywords": [
    "webhook",
    "nextjs",
    "edge-runtime",
    "vercel",
    "signature-verification",
    "retry-logic",
    "idempotency"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "bun-types": "latest",
    "dotenv": "^16.0.0",
    "esbuild": "^0.19.0",
    "next": "^14.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/madebyankur/wbhks.git"
  },
  "bugs": {
    "url": "https://github.com/madebyankur/wbhks/issues"
  },
  "homepage": "https://github.com/madebyankur/wbhks#readme"
}
